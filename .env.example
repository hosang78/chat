# Neon(또는 다른 Postgres) 연결 문자열
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 입장 비밀번호 (역할별로 분리)
USER_PASSWORD=shpoc!
ADMIN_PASSWORD=suhyup!

# 세션 쿠키 서명용 비밀키 (운영 배포 시 반드시 임의의 긴 문자열로 교체)
SESSION_SECRET=change-me-to-a-long-random-string

# 서버 포트 (Render는 자체적으로 PORT를 주입함)
PORT=3000

# 새 메시지 이메일 알림 (1시간마다 확인, 새 메시지가 있을 때만 발송)
# 아래 5개를 모두 채우면 활성화됨. 비워두면 알림 기능은 그냥 꺼진 채로 동작.
# Gmail 기준: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465
# SMTP_PASS는 Gmail 계정 비밀번호가 아니라 "앱 비밀번호"(구글 계정 > 보안 > 2단계 인증 > 앱 비밀번호)를 사용해야 함
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
NOTIFY_EMAIL_TO=your-gmail@gmail.com
