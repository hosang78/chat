# Neon(또는 다른 Postgres) 연결 문자열
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 입장 비밀번호 (역할별로 분리)
USER_PASSWORD=shpoc!
ADMIN_PASSWORD=suhyup!

# 세션 쿠키 서명용 비밀키 (운영 배포 시 반드시 임의의 긴 문자열로 교체)
SESSION_SECRET=change-me-to-a-long-random-string

# 서버 포트 (Render는 자체적으로 PORT를 주입함)
PORT=3000
